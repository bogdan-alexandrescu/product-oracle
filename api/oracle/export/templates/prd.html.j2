<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Product Oracle">
<title>{{ title }}{% if not link_holder %} — v{{ number }}{% endif %}{% if layer != "full" %} ({{ layer_label }}){% endif %}{% if audience_label %} ({{ audience_label }}){% endif %}</title>
<meta name="oracle-layer" content="{{ layer }}">
<style>
{{ css }}
{{ brand_css }}
{{ accent_css }}
</style>
</head>
<body>
<header class="version-banner status-{{ status }}" role="note" aria-label="Version">
  {{ brand_header }}
  <span class="banner-doc">{{ title }}</span>
  {% if not link_holder %}<span class="banner-version">Version {{ number }}</span>{% endif %}
  {% if audience_label %}<span class="banner-audience">Audience {{ audience_label }}</span>{% endif %}
  {% if layer != "full" %}<span class="banner-layer">{{ layer_label }}: the full document has the detail</span>{% endif %}
  {% if not link_holder %}<span class="banner-status">{{ status | replace("_", " ") | capitalize }}</span>{% endif %}
  {% if source_label %}<span class="banner-source"><a href="{{ source_url }}">{{ source_label }}</a></span>{% endif %}
  {% if not link_holder %}
  <span class="banner-date">
    {%- if approved_at %}Approved {{ approved_at }}{% else %}Imported {{ imported_at }}{% endif -%}
  </span>
  {% endif %}
  {% if snapshot %}<span class="banner-snapshot">Sources as of {{ snapshot }}</span>{% endif %}
</header>
<main class="prd">
{% if not has_title_section %}
  <h1 class="doc-title">{{ title }}</h1>
{% endif %}
{% for s in sections %}
  <section id="{{ s.key }}" class="prd-section level-{{ s.level }}" data-section-key="{{ s.key }}">
    <h{{ s.level }}>{{ s.heading }}</h{{ s.level }}>
    {{ s.body }}
  </section>
{% endfor %}
</main>
{% if footnotes %}
<footer class="citations">
  <h2 id="citations">Sources</h2>
  <ol class="footnotes">
  {% for f in footnotes %}
    <li id="fn-{{ f.number }}" value="{{ f.number }}" data-cite-key="{{ f.key }}">
      <span class="fn-title">
        {%- if f.href %}<a href="{{ f.href }}">{{ f.title }}</a>{% else %}{{ f.title }}{% endif -%}
      </span>
      <span class="fn-source">{{ f.source }}</span>
      {% if f.retrieved_at %}<span class="fn-retrieved">retrieved {{ f.retrieved_at }}</span>{% endif %}
      {% if f.excerpt %}<blockquote class="fn-excerpt">{{ f.excerpt }}</blockquote>{% endif %}
      <span class="fn-ref">{{ f.ref }}</span>
      {% if f.backref %}<a class="fn-back" href="#{{ f.backref }}" aria-label="Back to text">↩</a>{% endif %}
    </li>
  {% endfor %}
  </ol>
</footer>
{% endif %}
{% if added_footnotes %}
{# E1: citations added in a spec edit, outside Oracle's Sources. #}
<footer class="citations added-sources">
  <h2 id="added-sources">Added sources</h2>
  <p class="spec-state spec-state-added" data-spec-state="added">{{ added_label }}</p>
  <ol class="footnotes">
  {% for f in added_footnotes %}
    <li id="fn-{{ f.number }}" value="{{ f.number }}" data-cite-key="{{ f.key }}">
      <span class="fn-title">
        {%- if f.href %}<a href="{{ f.href }}">{{ f.title }}</a>{% else %}{{ f.title }}{% endif -%}
      </span>
      <span class="fn-source">{{ f.source }}</span>
      {% if f.retrieved_at %}<span class="fn-retrieved">retrieved {{ f.retrieved_at }}</span>{% endif %}
      <span class="fn-ref">{{ f.ref }}</span>
      {% if f.backref %}<a class="fn-back" href="#{{ f.backref }}" aria-label="Back to text">↩</a>{% endif %}
    </li>
  {% endfor %}
  </ol>
</footer>
{% endif %}
{% if evidence_links %}
<footer class="citations evidence-appendix">
  <h2 id="sources-evidence-links">Evidence links by section</h2>
  <ul class="by-section evidence-links">
  {% for e in evidence_links %}
    <li><a class="section-link" href="#{{ e.key }}">{{ e.heading }}</a>:
      {% for lk in e.links %}<span class="evidence-link">{% if lk.claim %}&ldquo;{{ lk.claim }}&rdquo; &mdash; {% endif %}{{ lk.label }}{% if lk.confidence is not none %} ({{ '%.2f' % lk.confidence }}){% endif %}</span>{% if not loop.last %}; {% endif %}{% endfor %}
    </li>
  {% endfor %}
  </ul>
</footer>
{% endif %}
</body>
</html>
