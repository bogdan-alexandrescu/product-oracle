  "motion": {
    "durations": {
      "fast": 150,
      "base": 220,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(.3,0,.1,1)"
    },
    "rules": "Unhurried fades and 8px rises; margin notes fade in beside their claim. Reduced motion: fades only."
