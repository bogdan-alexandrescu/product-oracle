{
  "pyright": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/agent-tool",
    "args": ["pyright-langserver", "--stdio"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  },
  "typescript": {
    "command": "${CLAUDE_PLUGIN_ROOT}/bin/agent-tool",
    "args": ["typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript"
    }
  }
}
