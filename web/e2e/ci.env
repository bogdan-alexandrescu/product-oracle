# Settings for the mock Playwright suite in CI (`npm run test:ci` loads this file).
# SwarmCloud's sharded suite gate names it as env_file. Non-secret: no keys, no company data.
# Variables already set in the environment win over the values here.

# Mock API, inlined into the .next-mock build (no backend, no Postgres).
NEXT_PUBLIC_API_MOCKS=1
# Port the config's webServer builds and starts the mock app on.
E2E_PORT=3100
CI=1
E2E_WORKERS=2
E2E_RETRIES=1
NEXT_TELEMETRY_DISABLED=1
