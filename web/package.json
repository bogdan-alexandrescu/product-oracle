{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:mock": "NEXT_PUBLIC_API_MOCKS=1 NEXT_DIST_DIR=.next-mock next build",
    "start:mock": "NEXT_PUBLIC_API_MOCKS=1 NEXT_DIST_DIR=.next-mock next start",
    "dev:mock": "NEXT_PUBLIC_API_MOCKS=1 next dev",
    "test:e2e": "playwright test",
    "test:ci": "node --env-file=e2e/ci.env node_modules/@playwright/test/cli.js test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "prose:ratchet": "node e2e/prose-ratchet.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "pyright": "1.1.414",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
